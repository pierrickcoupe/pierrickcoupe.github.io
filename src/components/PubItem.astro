---
// One publication. Long author lists are shortened around P. Coupé.
interface Props { pub: any; showYear?: boolean; }
const { pub, showYear = false } = Astro.props;
const ME = /^P\.\s?Coup[eé]$/i;
let authors: string[] = pub.authors || [];
const MAX = 10;
if (authors.length > MAX) {
  const idx = authors.findIndex((a) => ME.test(a));
  const head = authors.slice(0, 8);
  authors = idx >= 8 ? [...head, '…', authors[idx], ...(idx < authors.length - 1 ? ['…'] : [])] : [...head, '…'];
}
const typeLabel: Record<string, string> = { journal: 'Journal', conference: 'Conference', chapter: 'Chapter', book: 'Book', thesis: 'Thesis', preprint: 'Preprint', other: 'Other' };
const searchText = [pub.title, (pub.authors || []).join(' '), pub.venue, pub.year].join(' ').toLowerCase();
---
<article class="pub" data-type={pub.type} data-year={pub.year} data-search={searchText}>
  {showYear && <div class="pub__year">{pub.year}</div>}
  <div class="pub__body">
    <h3 class="pub__title">
      {pub.link ? <a href={pub.link}>{pub.title}</a> : pub.title}
    </h3>
    {authors.length > 0 && (
      <p class="pub__authors">
        {authors.map((a, i) => (
          <>{ME.test(a) ? <strong>{a}</strong> : a}{i < authors.length - 1 && a !== '…' && authors[i + 1] !== '…' ? ', ' : ' '}</>
        ))}
      </p>
    )}
    <p class="pub__venue">
      {pub.venue && <em>{pub.venue}</em>}
      {pub.venue && pub.type !== 'journal' && ' · '}
      {pub.type !== 'journal' && <span>{typeLabel[pub.type] || pub.type}</span>}
    </p>
    <div class="pub__links">
      {pub.pdf && <a class="tag tag--ok" href={pub.pdf}>PDF · HAL</a>}
      {pub.doi && <a class="tag tag--accent" href={`https://doi.org/${pub.doi}`}>DOI</a>}
      {!pub.pdf && pub.halPage && <a class="tag tag--neutral" href={pub.halPage}>HAL</a>}
    </div>
  </div>
</article>

<style>
  .pub { display: flex; flex-wrap: wrap; gap: 8px 32px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .pub__year { flex: 0 0 64px; font-weight: 600; color: var(--subtle); }
  .pub__body { flex: 999 1 400px; min-width: 0; }
  .pub__title { margin: 0 0 6px; font-size: 17px; font-weight: 600; line-height: 1.45; }
  .pub__title a { color: var(--ink); }
  .pub__title a:hover { color: var(--accent); }
  .pub__authors { margin: 0 0 4px; font-size: 14px; color: var(--muted); }
  .pub__authors strong { color: var(--ink); font-weight: 600; }
  .pub__venue { margin: 0 0 10px; font-size: 14px; color: var(--ink-2); }
  .pub__venue:empty { display: none; }
  .pub__links { display: flex; flex-wrap: wrap; gap: 8px; }
  .pub__links:empty { display: none; }
</style>
