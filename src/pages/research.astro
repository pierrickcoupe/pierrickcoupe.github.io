---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { load, url } from '../lib/data.js';

const research = load('research.yaml');
const projects = load('projects.yaml');
const holi = projects.find((p) => p.name === 'HoliBrain');
const deep = projects.find((p) => p.name === 'DeepvolBrain');
---
<Base title="Research" description="Deep learning, big data and cloud solutions for brain MRI analysis." active="research">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Research</p>
      <h1>Measuring the brain at scale</h1>
      <p class="intro">My research develops computational methods to analyse brain MRI — from new deep learning architectures to lifespan models built on tens of thousands of scans — and makes them available to clinicians and researchers through open platforms.</p>
      <nav class="axis-nav" aria-label="Research axes">
        {research.map((r) => <a href={`#${r.id}`}>{r.title}</a>)}
      </nav>
    </div>
  </section>

  {research.map((r, i) => (
    <section id={r.id} class={`section ${i % 2 ? 'section--soft' : ''}`}>
      <div class="container axis">
        <div class="axis__head">
          <div class="icon-tile"><Icon name={r.icon} color="#2459C9" /></div>
          <h2 class="h2">{r.title}</h2>
          <p class="axis__intro">{r.intro}</p>
        </div>
        <div class="axis__points">
          {r.points.map((pt) => (
            <div class="point">
              <h3>{pt.title}</h3>
              <p>{pt.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section section--dark">
    <div class="container">
      <p class="eyebrow">Main projects</p>
      <h2 class="h2" style="margin-bottom: 32px">Where these ideas come together</h2>
      <div class="grid">
        <article class="card card--dark">
          <div class="card-meta"><span>{holi.funder} · ANR-23-CE45-0020</span><span>{holi.period}</span></div>
          <h3 style="font-size: 22px">HoliBrain</h3>
          <p style="margin-bottom: 12px">Replacing task-by-task analysis of brain MRI with a holistic approach: a large ensemble of collaborating networks analysing high-resolution multimodal MRI across structures and scales, to discover new biomarkers for early diagnosis.</p>
          <p>Outputs include an ultra-high-resolution holistic brain atlas, DeepCERES, DeepThalamus and petBrain.</p>
        </article>
        <article class="card card--dark">
          <div class="card-meta"><span>{deep.funder} · ANR-18-CE45-0013</span><span>{deep.period}</span></div>
          <h3 style="font-size: 22px">DeepvolBrain</h3>
          <p style="margin-bottom: 12px">Deep learning methods robust to scarce training data and large volumes of heterogeneous images, with automatic quality control, deployed on an open-access platform built on volBrain.</p>
          <p>Outputs include AssemblyNet, DeepLesionBrain and vol2Brain.</p>
        </article>
      </div>
      <p style="margin: 32px 0 0"><a class="more" href={url('projects/')}>All projects →</a></p>
    </div>
  </section>
</Base>

<style>
  .axis-nav { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 28px; font-weight: 600; font-size: 15px; }
  .axis { display: flex; flex-wrap: wrap; gap: 48px; }
  .axis__head { flex: 1 1 360px; }
  .axis__intro { color: var(--muted); font-size: 17px; margin: 0; }
  .axis__points { flex: 1.3 1 420px; display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--line); }
  .point { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .point h3 { margin: 0 0 6px; font-size: 18px; }
  .point p { margin: 0; color: var(--muted); font-size: 15px; }
</style>
