---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { load, url } from '../lib/data.js';

const sw = load('software.yaml');
---
<Base title="Software" description="volBrain and open research software for MRI denoising, segmentation and super-resolution." active="software">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Software &amp; platforms</p>
      <h1>Open tools for the community</h1>
      <p class="intro">Methods developed in my group are made available as an online platform and as downloadable research code.</p>
    </div>
  </section>

  <section class="container section" style="padding-top: 48px">
    <div class="platform">
      <div class="platform__text">
        <img src={url('images/volbrain-light.svg')} alt="" aria-hidden="true" width="80" height="74" />
        <div class="card-meta" style="color: var(--on-navy-accent); margin-bottom: 0">Online platform</div>
        <h2>{sw.platform.name}</h2>
        <p>{sw.platform.text}</p>
        <a class="btn btn--light" href={sw.platform.url}>Open volBrain <Icon name="external" size={16} /></a>
      </div>
      <div class="platform__list">
        <div class="label" style="color: var(--on-navy-accent)">Pipelines available</div>
        <ul>
          {sw.pipelines.map((p) => <li><strong>{p.name}</strong><span>{p.text}</span></li>)}
        </ul>
      </div>
    </div>

    <h2 class="h2" style="margin-top: 72px">Research code</h2>
    <p class="lead" style="margin-bottom: 24px">Classic methods for MRI enhancement and segmentation, mostly as Matlab / C-MEX code.</p>
    <div class="grid grid--sm">
      {sw.toolboxes.map((t) => (
        <a class="card" href={t.url}>
          <div style="font-weight: 600; margin-bottom: 4px">{t.name}</div>
          <div style="font-size: 14px; color: var(--muted)">{t.text}</div>
        </a>
      ))}
    </div>
    <p class="note">{sw.license}</p>
    <p style="margin-top: 8px"><a href={url('publications/#software')}>List of registered software (APP) →</a></p>
  </section>
</Base>

<style>
  .platform { background: var(--navy); color: #fff; border-radius: var(--radius); padding: 40px; display: flex; flex-wrap: wrap; gap: 40px; }
  .platform__text { flex: 1 1 340px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .platform__text h2 { margin: 0; font-size: 32px; font-family: var(--serif); }
  .platform__text p { margin: 0 0 8px; color: var(--on-navy); }
  .platform__text .btn { gap: 8px; }
  .platform__list { flex: 1 1 380px; }
  .platform__list ul { list-style: none; margin: 0; padding: 0; }
  .platform__list li { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 2px 16px; padding: 10px 0; border-bottom: 1px solid var(--navy-line); font-size: 15px; }
  @media (max-width: 520px) { .platform__list li { grid-template-columns: 1fr; } }
  .platform__list li span { color: var(--on-navy); }
  @media (max-width: 640px) { .platform { padding: 24px; } }
  .note { margin-top: 24px; font-size: 14px; color: var(--muted); max-width: 760px; }
</style>
