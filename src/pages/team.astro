---
import Base from '../layouts/Base.astro';
import { load } from '../lib/data.js';

const team = load('team.yaml');
const profile = load('profile.yaml');
---
<Base title="Team" description="The in2brain group at LaBRI: current members, alumni and open positions." active="team">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Team</p>
      <h1>The in2brain group</h1>
      <p class="intro">in2brain is a research group of LaBRI (CNRS, University of Bordeaux, Bordeaux INP) working on artificial intelligence for brain imaging, in close collaboration with neuroscientists and clinicians.</p>
    </div>
  </section>

  <section class="container section" style="padding-top: 48px">
    <h2 class="h2" style="margin-bottom: 24px">Current members</h2>
    <div class="grid grid--sm">
      {team.current.map((m) => (
        <div class="card">
          <div style="font-weight: 600; font-size: 17px">{m.name}</div>
          <div style="font-size: 14px; color: var(--muted)">{m.role} · since {m.since}</div>
        </div>
      ))}
    </div>

    <h2 id="alumni" class="h2" style="margin: 64px 0 24px">Alumni</h2>
    <div class="alumni">
      <div>
        <h3>PhD students</h3>
        <ul>{team.alumni.phd.map((m) => <li><span>{m.name}</span><span class="when">{m.period}</span></li>)}</ul>
      </div>
      <div>
        <h3>Postdoctoral fellows</h3>
        <ul>{team.alumni.postdocs.map((m) => <li><span>{m.name}</span><span class="when">{m.period}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <section id="positions" class="section section--soft">
    <div class="container">
      <p class="eyebrow">Join us</p>
      <h2 class="h2">Open positions</h2>
      {team.positions.length ? (
        <div class="rows" style="margin-top: 24px">
          {team.positions.map((p) => (
            <div class="row">
              <div class="row__date">{p.period}</div>
              <div class="row__main"><h3>{p.title}</h3></div>
              <div class="row__side"><a href={p.url}>Position description →</a></div>
            </div>
          ))}
        </div>
      ) : (
        <p class="lead" style="margin-bottom: 0">There is no open position at the moment. Motivated candidates for PhD, postdoc or internship positions in deep learning and neuroimaging are welcome to send a CV and a short statement of interest to <a href={`mailto:${profile.email}`}>{profile.email}</a>.</p>
      )}
    </div>
  </section>
</Base>

<style>
  .alumni { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 40px; }
  .alumni h3 { margin: 0 0 12px; font-size: 18px; }
  .alumni ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .alumni li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .when { color: var(--subtle); font-size: 15px; white-space: nowrap; }
</style>
